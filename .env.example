# Copia questo file in `.env.local` (ignorato da git) e compila i valori dal tuo progetto Supabase.
# Sono SOLO valori pubblicabili. MAI la chiave segreta / service_role.
VITE_SUPABASE_URL=https://<id-progetto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<chiave pubblicabile (sb_publishable_... oppure anon)>
